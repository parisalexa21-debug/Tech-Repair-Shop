# Server bind address — use 0.0.0.0 when the app should listen on all interfaces (typical on LAN).
HOST=127.0.0.1
PORT=4000

# When your internal network is ready, set allowed browser origins (comma-separated).
# Example: http://192.168.1.50:5173,http://repair-shop.local
CORS_ORIGIN=http://localhost:5173

# AI chat provider settings (server-only; never expose in frontend code)
# Example values:
# CHAT_API_URL=https://api.openai.com/v1/chat/completions
# CHAT_MODEL=gpt-4o-mini
CHAT_API_URL=https://api.openai.com/v1/chat/completions
CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace_with_real_api_key
CYBERLAB_API_KEY=replace_with_real_api_key
